# API Gateway environment example
# Copy to .env and adjust per environment.

# Upstream service base URLs (http or https). In local dev these might be docker service names.
USER_SERVICE_URL=http://userservice:8000
BOOKING_SERVICE_URL=http://bookingservice:8000
VENUE_SERVICE_URL=http://venueservice:8000
NOTIFICATION_SERVICE_URL=http://notificationservice:8000
ADMIN_SERVICE_URL=http://adminservice:8000

# JWT/OAuth2 configuration (stubs are used if not fully configured)
JWT_ISSUER=event-platform
JWT_AUDIENCE=event-platform-clients
JWT_SECRET=change-me
JWT_ALG=HS256

# CORS configuration (comma-separated origins or * for all)
CORS_ALLOW_ORIGINS=*

# Optional stub rate limiter (requests per minute per client IP). 0 disables.
RATE_LIMIT_PER_MINUTE=0

# Environment: development, staging, production
ENVIRONMENT=development
